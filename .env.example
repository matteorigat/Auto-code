# ── OpenCode Bridge Telegram ───────────────────────────────────────
# Copia questo file come .env e modifica i valori
# NON committare .env !!!

# Obbligatorio: token del bot Telegram (da @BotFather)
TELEGRAM_BOT_TOKEN=inserisci_il_token_qui

# Opzionale: ID utenti Telegram autorizzati (separati da virgola)
TELEGRAM_ALLOWED_USER_ID=xxxxx

# Opzionale: modello predefinito per opencode
OPENCODE_DEFAULT_MODEL=openai/tier-4-planner
OPENAI_API_KEY=sk-litellm-local

# Opzionale: porta per opencode serve (solo v3)
OPENCODE_PORT=4096

# Opzionale: porta per il loop health server
HEALTH_PORT=9090

# MODALITÀ: "api" (opencode serve) o "cli" (opencode run)
BRIDGE_MODE=api

# Timeout massimo sessione in minuti (0 = nessun limite, default 1440 = 24h)
SESSION_TIMEOUT_MINUTES=1440

# Stall detection: avvisa se non arrivano eventi per X min (0 = disabilita)
STALL_TIMEOUT_MINUTES=30

# ── Hydra Loop (24/7 autonomous agent) ──────────────────────────────
# Obbligatorio per loop 24/7: token API Notion (cambia in .env reale)
NOTION_API_TOKEN=ntn_xxxxx

# Opzionale: ID del database Notion per il backlog
NOTION_DATABASE_ID=xxxxx
NOTION_PAGE_ID=xxxxx

# Opzionale: chat ID Telegram dove inviare status e alert del loop
# Se non impostato, il loop lo deduce dal bridge via .hydra/bridge-chat.json
HYDRA_CHAT_ID=xxxxx

# Opzionale: cost guard — costo massimo giornaliero in USD (default 10.0)
LOOP_DAILY_COST_LIMIT=10.0

# Opzionale: tentativi massimi per task prima di BLOCKED (default 3)
LOOP_MAX_ATTEMPTS=3

# Opzionale: timeout massimo per ciclo agente in ms (default 900000 = 15 min)
LOOP_MAX_CYCLE_MS=900000

# ── LLM Providers keys ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxx
NVIDIA_API_KEY=nvapi-xxxxx
GROQ_API_KEY=gsk_xxxxx
MISTRAL_API_KEY=xxxxx
CEREBRAS_API_KEY=csk-xxxxx
KILOCODE_API_KEY=xxxxx
OPENCODE_API_KEY=sk-xxxxx
GEMINI_API_KEY=AIzaSyxxxxx
XAI_API_KEY=xai-xxxxx

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=xxxxx
CLOUDFLARE_API_TOKEN=cfut_xxxxx

# Modal Runner Configuration
MODAL_TOKEN_ID=ak-xxxxx
MODAL_TOKEN_SECRET=as-xxxxx
MODAL_WORKSPACE_TOKEN=xxxxx

# Ollama Endpoint Configuration
OLLAMA_API_KEY=xxxxx
