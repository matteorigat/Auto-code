  "description": "Autonomous Agent Orchestrator with SOTA Architecture",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:dashboard": "tsx src/dashboard/index.ts",
    "build:frontend": "tsc -p dashboard/js",
