{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "openai/tier-4-planner",
  "compaction": { "auto": true, "prune": true, "reserved": 30000 },
  "provider": {
    "openai": {
      "apiKey": "sk-1234",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "headerTimeout": 120000,
        "timeout": 180000
      }
    },
    "ollama": {
      "apiKey": "ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "headerTimeout": 120000,
        "timeout": 300000
      }
    }
  },
  "agent": {
    "tier-4": {
      "model": "openai/tier-4-planner",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-3": {
      "model": "openai/tier-3-builder",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-2": {
      "model": "openai/tier-2-hunter",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-1": {
      "model": "openai/tier-1-trivial",
      "fallbacks": ["ollama/gemma4:12b"]
    }
  }
}
