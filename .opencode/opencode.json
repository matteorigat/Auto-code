{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "openai/auto/best-coding",
  "compaction": { "auto": true, "prune": true, "reserved": 30000 },
  "provider": {
    "openai": {
      "apiKey": "{env:OMNIROUTE_API_KEY}",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "headerTimeout": 120000,
        "timeout": 180000
      }
    },
    "ollama": {
      "apiKey": "ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "headerTimeout": 120000,
        "timeout": 300000
      }
    }
  },
  "agent": {
    "tier-4": {
      "model": "openai/auto/best-reasoning",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-3": {
      "model": "openai/auto/best-coding",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-2": {
      "model": "openai/auto/best-coding",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-1": {
      "model": "openai/auto/fast",
      "fallbacks": ["ollama/gemma4:12b"]
    }
  }
}
