{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "model-router/deepseek-v4-flash-free",
  "compaction": { "auto": true, "prune": true, "reserved": 30000 },
  "provider": {
    "model-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ModelRouter",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "bridge-telegram-model-router"
      },
      "models": {
        "big-pickle": { "name": "big-pickle", "limit": { "context": 128000, "output": 8192 } },
        "deepseek-v4-flash-free": { "name": "deepseek-v4-flash-free", "limit": { "context": 128000, "output": 8192 } },
        "north-mini-code-free": { "name": "north-mini-code-free", "limit": { "context": 128000, "output": 8192 } },
        "minimax-m3-free": { "name": "minimax-m3-free", "limit": { "context": 128000, "output": 8192 } }
      }
    },
    "ollama": {
      "apiKey": "ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "headerTimeout": 120000,
        "timeout": 300000
      }
    }
  },
  "agent": {
    "tier-4": {
      "model": "model-router/big-pickle",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-3": {
      "model": "model-router/deepseek-v4-flash-free",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-2": {
      "model": "model-router/north-mini-code-free",
      "fallbacks": ["ollama/gemma4:12b"]
    },
    "tier-1": {
      "model": "model-router/minimax-m3-free",
      "fallbacks": ["ollama/gemma4:12b"]
    }
  }
}
