{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": false,
    "paths": {
      "@core/*": ["src/core/*"],
      "@services/*": ["src/services/*"],
      "@bot/*": ["src/bot/*"],
      "@dashboard/*": ["src/dashboard/*"],
      "@config/*": ["src/config/*"],
      "@prompts/*": ["src/prompts/*"],
      "@agents/*": ["agents/*"]
    }
  },
  "include": ["src/**/*", "agents/**/*", "bin/**/*", "tests/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist"]
}
